{
  "name": "todo-list",
  "version": "1.0.0",
  "description": "To-Do List — лабораторные №4 (Sass + Tailwind)",
  "scripts": {
    "sass:dev": "sass --watch scss/main.scss:dist/css/main.css",
    "sass:build": "sass --no-source-map --style=compressed scss/main.scss:dist/css/main.css",
    "tailwind:dev": "tailwindcss -i ./src/input.css -o ./dist/css/main.css --watch",
    "build": "tailwindcss -i ./src/input.css -o ./dist/css/main.css --minify"
  },
  "author": "Киселев Максим, ФИТ-241",
  "license": "ISC",
  "devDependencies": {
    "sass": "^1.80.0",
    "tailwindcss": "...",
    "@tailwindcss/cli": "..."
  }
}